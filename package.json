{
  "name": "fastify-react-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify React starter — Fastify + @fastify/react + Drizzle + Better Auth + pg-boss",
  "scripts": {
    "dev": "tsx cmd/web/main.ts",
    "worker": "tsx cmd/worker/main.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx cmd/web/main.ts",
    "start:worker": "NODE_ENV=production tsx cmd/worker/main.ts",
    "test": "tsx test/run-tests.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/react": "^1.2.2",
    "@fastify/vite": "^10.0.0",
    "@fontsource/hedvig-letters-sans": "^5.3.0",
    "@fontsource/hedvig-letters-serif": "^5.3.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next-themes": "^0.4.6",
    "pg-boss": "^12.35.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
