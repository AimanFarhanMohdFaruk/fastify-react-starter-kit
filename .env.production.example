# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Point DATABASE_URL at a cloud Postgres that has (or allows) pgvector.
# APP_URL must match the public URL users hit (nginx).

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
APP_URL=http://localhost
HOST_PORT=80
