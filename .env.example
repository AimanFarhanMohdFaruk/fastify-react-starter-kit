DATABASE_URL=postgres://kit:kit@localhost:5432/starter_kit
APP_URL=http://localhost:3000
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
# Required when NODE_ENV=production (Better Auth rejects the default secret).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# S3-compatible object store (local RustFS via docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=starter-kit
